---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NavButtons from "../../components/nav-buttons.astro";

const posts = await getCollection('blog');
const tagColors: Record<string, string> = {
    test: 'bg-gray-100 text-gray-700',
    Music: 'bg-pink-100 text-pink-700',
    Games: 'bg-orange-100 text-orange-700',
    Review: 'bg-yellow-100 text-yellow-700',
    Lifestyle: 'bg-green-100 text-green700',
    Gym: 'bg-red-100 text-red-700'
}
const defaultTagColor = 'bg-blue-100 text-blue-700'

const allTags = [...new Set(posts.flatMap(post => post.data.tags ?? []))];
---
<Layout title="Aria's Blog" bgColor="bg-blue-200">
    <NavButtons color="blue"/>
    <div style="max-width: 700px; margin: 0 auto; padding: 2rem 1rem;" class="flex flex-col items-center">
        <h1 class="text-5xl text-shadow-lg font-handwriting mb-8 text-white underline">My Blog ✎</h1>
        <div class = "flex flex-wrap gap-2 mb-6" id="tag-filters">
            <button class={`tag-filter-btn active bg-white text-black`} data-tag="all">All</button>
            {allTags.map(tag => (
                <button class={`tag-filter-btn ${tagColors[tag] ?? defaultTagColor} transition-all hover:brightness-125`} data-tag={tag}>{tag}</button>
            ))}
        </div>
        <div class="bg-white fade-in-delay shadow-md border border-4 border-solid border-sky-700 p-3 w-full" style={{"--downtime": '0.2s'}}>
            <ul class="post-list" id="post-list">
                {posts.map((post, index) => (
                    <li class="py-3 fade-in-delay" style={{"--downtime": `${index * 0.4}s`}} data-tags={post.data.tags?.join(',') ?? ''}>
                        <a href={`/blog/${post.id}/`} class="post-row">
                            <span class="title">{post.data.title}</span>
                            <div class="meta-row">
                                <span class="description notebook-lines">{post.data.description}</span>
                                <div class="tags">
                                    {post.data.tags?.map(tag => (
                                        <span class={`tag-badge ${tagColors[tag] ?? defaultTagColor}`}>{tag}</span>
                                    ))}
                                </div>
                            </div>
                            <span class="date">{post.data.pubDate.toDateString()}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</Layout>

<style>
    .post-row {
        display: grid;
        grid-template-rows: auto auto auto;
        gap: 0.5rem;
        align-items:start;
        color: #5281e6;
        font-size: 1.125rem;
    }
    .title {
        font-weight: 500;
    }
    .post-row:hover .title {
        text-decoration: underline;
        color: #87adff;
    }
    .meta-row {
        display:flex;
        justify-content: space-between;
        width: 100%;
        align-items: flex-start;
    }
    .description {
        font-weight: 300;
        color: #6b7280;
        font-size: 0.875rem;
    }
    .tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .tag-badge {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 0.375rem;
        font-weight: 500;
    }
    .tag-filter-btn {
        padding: 0.4rem 0.8rem;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
    }
    .tag-filter-btn.active {
        background: #0369a1;
        color: white;
        border-color: #0369a1;
    }
    .date {
        color:#6b7280;
        font-size: 0.75rem;
        text-align: right;
    }
    .post-list li {
        border-top: 1px solid #4b5563; /* matches your divide-green-400 color */
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
    }
    .post-list li.no-top-border {
        border-top: none;
    }
</style>

<script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const posts = document.querySelectorAll<HTMLLIElement>('#post-list li');
    
    function applyFilter(selectedTag : string) {
        let visibleIndex = 0;
        let firstVisibleFound = false;

        posts.forEach(post => {
            const postTags = post.dataset.tags?.split(',') ?? [];
            const shouldShow = selectedTag === 'all' || postTags.includes(selectedTag ?? '');
        
            if (shouldShow) {
                post.style.setProperty('--downtime', `${visibleIndex * 0.15}s`);
                post.style.display = '';

                if (!firstVisibleFound) {
                    post.classList.add('no-top-border');
                    firstVisibleFound = true;
                } else {
                    post.classList.remove('no-top-border');
                }

                post.classList.remove('fade-in-delay');
                void post.offsetWidth;
                post.classList.add('fade-in-delay');

                visibleIndex++;
            } else {
                post.style.display = 'none';
            }
        })
    }
    
    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const selectedTag = btn.dataset.tag ?? 'all';

            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            applyFilter(selectedTag);
        });
    });

    applyFilter('all');
</script>