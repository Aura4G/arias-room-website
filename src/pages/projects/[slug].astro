---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NavButtons from "../../components/nav-buttons.astro";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map(project => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Tag colours to be plugged in
const tagColors: Record<string, string> = {
    // Programming Languages
    "C": "bg-blue-100 text-blue-700",
    "C++": "bg-blue-400 text-white",
    Python: "bg-sky-700 text-yellow-400",
    JavaScript: "bg-yellow-300 text-black",
    Golang: "bg-white text-blue-400",

    // Frameworks
    Jupyter: "bg-orange-400 text-gray-700",
    Tailwind: "bg-sky-100 text-sky-700",
    Astro: "bg-fuchsia-900 text-white",
    PyTorch: "bg-red-700 text-white",
    OpenGL: "bg-fuchsia-700 text-white",
    SFML: "bg-lime-100 text-lime-700",

    // Topics
    "Computer Vision": "bg-gray-900 border border-blue-400 text-blue-400",
    "Deep Learning": "bg-sky-400 text-sky-900",
    "Machine Learning": "bg-pink-100 text-pink-700",
    AI: "bg-slate-800 text-orange-600 border-1 border-orange-700",
    FER: "bg-olive-100 text-olive-700",

    // Mediums
    Videogame: "bg-red-100 text-red-700 border-2 border-red-700",
    Website: "bg-yellow-100 text-yellow-700 border-2 border-yellow-700",
    Teaching: "bg-green-100 text-green-700 border-2 border-green-700",
    Application: "bg-sky-100 text-sky-700 border-2 border-sky-700",
    Hackathon: "bg-yellow-200 text-yellow-600 border-2 border-yellow-400"
};
const defaultTagColor = "bg-black text-green-400 border border-green-400";
---

<!-- Design for an individual project post -->
<Layout title={project.data.title} bgColor="bg-black">
    <NavButtons color="green" font="font-mono"/>
    <article style="max-width: 700px; margin: 0 auto; padding: 3rem 1rem;" class="font-mono">
        <a href="/projects/" class="inline-block text-sm px-2 py-1 text-black bg-green-400 mb-4 hover:bg-green-800">
            ← Back to Projects
        </a>
        <!-- Typing effect on the project title, simple as the chars variable can be set to the number of characters in the title -->
        <h1 class="typing text-4xl text-green-400 underline mb-4" style={{"--chars": project.data.title.length, "--speed": '1s', "fontSize": `clamp(1.25rem, ${40 / project.data.title.length}rem, 2.25rem)`}}>{project.data.title}</h1>
        <div class="tags mb-8 fade-in-delay" style={{"--downtime": '0.1s'}}>
            {project.data.tags?.map(tag => (
                <span class={`tag-badge ${tagColors[tag] ?? defaultTagColor}`}>{tag}</span> // Match the tag string to the tailwindcss excerpt in the frontmatter to get the appropriate colour
            ))}
        </div>
        <!-- The markdown content of the project; use the prose class so it can be styled -->
        <div class="prose prose-sm prose-invert max-w-none mb-4 fade-in-delay" style={{"--downtime": '0.2s'}}>
            <Content />
        </div>
        <div class="flex flex-col gap-4">
            {project.data.link && (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="fade-in-delay text-sm text-blue-400 underline hover:text-blue-600" style={{"--downtime": '0.3s'}}>See this project! ↗</a>
            )}
            {project.data.repo && (
                <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="fade-in-delay text-sm text-blue-400 underline hover:text-blue-600" style={{"--downtime": '0.3s'}}>See this project's repository! ↗</a>
            )}
        </div>
    </article>
</Layout>

<style>
    /* Styling for the tag badges appearing at the top of the project's page */
    .tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }
    .tag-badge {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 0.375rem;
        font-weight: 500;
        display: flex;
        justify-content: center;
        align-items: center;
    }    
</style>