---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NavButtons from "../../components/nav-buttons.astro";

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map(project => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Tag colours to be plugged in
const tagColors: Record<string, string> = {
    'C': 'bg-blue-100 text-blue-700',
    'C++': 'bg-pink-100 text-pink-700',
    Astro: 'bg-fuchsia-100 text-fuchsia-700',
    JavaScript: 'bg-orange-100 text-orange-700',
    Tailwind: 'bg-sky-100 text-sky-700',
    Videogame: 'bg-red-100 text-red-700 border-2 border-red-700',
    Website: 'bg-yellow-100 text-yellow-700 border-2 border-yellow-700',
    Conversation: 'bg-green-100 text-green700'
}
const defaultTagColor = 'bg-black text-green-400 border border-green-400'
---

<!-- Design for an individual project post -->
<Layout title={project.data.title} bgColor="bg-black">
    <NavButtons color="green" font="font-mono"/>
    <article style="max-width: 700px; margin: 0 auto; padding: 3rem 1rem;" class="font-mono">
        <a href="/projects/" class="inline-block text-sm px-2 py-1 text-black bg-green-400 mb-4 hover:bg-green-800">
            ← Back to Projects
        </a>
        <!-- Typing effect on the project title, simple as the chars variable can be set to the number of characters in the title -->
        <h1 class="typing text-4xl text-green-400 underline mb-4" style={{"--chars": project.data.title.length, "--speed": '1s'}}>{project.data.title}</h1>
        <div class="tags mb-8 fade-in-delay" style={{"--downtime": '0.1s'}}>
            {project.data.tags?.map(tag => (
                <span class={`tag-badge ${tagColors[tag] ?? defaultTagColor}`}>{tag}</span> // Match the tag string to the tailwindcss excerpt in the frontmatter to get the appropriate colour
            ))}
        </div>
        <!-- The markdown content of the project; use the prose class so it can be styled -->
        <div class="prose prose-sm max-w-none text-green-400 mb-4 fade-in-delay" style={{"--downtime": '0.2s'}}>
            <Content />
        </div>
        <a href={project.data.link} target="_blank" class="fade-in-delay text-sm text-blue-400 underline hover:text-blue-600" style={{"--downtime": '0.3s'}}>See this project!</a>
    </article>
</Layout>

<style>
    /* Styling for the tag badges appearing at the top of the project's page */
    .tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }
    .tag-badge {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 0.375rem;
        font-weight: 500;
    }    
</style>