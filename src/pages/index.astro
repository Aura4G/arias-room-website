---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Aria's Office" bgColor="bg-white">
	<div class="flex flex-col items-center justify-center min-h-[70vh] text-center gap-6">
		<h1 class="font-display text-5xl font-bold underline decoration-double">Aria's Office</h1>		
		<div class="flex justify-between w-full px-4 md:px-[15%]">
			<div class="flex flex-col items-center gap-2 group">
				<a href="/blog/" class=" px-8 py-7 border border-solid border-black bg-white text-xl text-black hover:text-blue-400 hover:bg-sky-100 hover:border-blue-600 duration-300 ">Blog</a>
				<span class="text-2xl text-black group-hover:text-blue-400 transition-colors duration-300">↓</span>
				<img src="/images/front-page/blog-scroll.png" alt="Blog" class="w-63 h-96 object-cover">
			</div>
			<div class="flex flex-col items-center gap-2 group">
				<a href="/about/" class=" px-8 py-7 border border-solid border-black bg-white text-xl text-black hover:text-purple-400 hover:border-purple-600 hover:bg-purple-200 duration-300">About Me!</a>
				<span class="text-2xl text-black group-hover:text-purple-400 transition-colors duration-300">↓</span>
				<img src="/images/front-page/aria-chair.gif" alt="About Me!" class="w-63 h-96 object-cover">
			</div>
			<div class="flex flex-col items-center gap-2 group">
				<a href="/projects/" id="matrix-btn" class="relative overflow-hidden inline-block px-8 py-7 border border-black text-xl text-black font-mono hover:border-green-400 hover:text-green-400 hover:bg-black transition-colors duration-300">
					<span id="matrix-layer" class="absolute inset-0 pointer-events-none z-0"></span>
					<span class="relative z-10">Projects</span>
				</a>
				<span class="text-2xl text-black group-hover:text-green-400 transition-colors duration-300">↓</span>
				<img src="https://placehold.co/150x150/000000/22c55e?text=Projects" alt="Projects Preview" class="w-32 h-32 object-cover rounded-lg">
			</div>
			<div class="flex flex-col items-center gap-2">
				<a href="#" id="nowplaying-btn" target="_blank" class="flex items-center gap-4 px-4 py-3 border border-solid border-red-600 bg-white text-xl text-red-400 w-65 hover:bg-red-200 duration-300 ">
					<img id="nowplaying-art" src="/images/misc/default-album.png" alt="Album art" class="w-16 h-16 object-cover rounded-md flex-shrink-0">
					<div class="flex flex-col text-left overflow-hidden">
						<span id="nowplaying-song" class="truncate text-lg font-semibold text-red-700">Loading...</span>
						<span id="nowplaying-artist" class="truncate text-sm text-red-500">...</span>
						<span id="nowplaying-status" class="truncate text-xs text-red-400">...</span>
					</div>
				</a>
				<span id="music-arrow" class="text-2xl text-red-400">↓</span>
				<img src="/images/front-page/music-player.gif" alt="Music Player" id="vinyl-art" class="w-63 h-96 object-cover">
			</div>
		</div>
	</div>
</Layout>

<style>
	.matrix-char {
		position: absolute;
		top: -20px;
		color: #22c55e;
		font-family: monospace;
		font-size: 14px;
		animation: matrix-fall 1s linear forwards;
	}
	@keyframes matrix-fall {
		0% { transform: translateY(var(--start-y)); opacity: 0; }
		20% { opacity: 1; }
		80% { opacity: 1; }
		100% { transform: translateY(calc(var(--start-y) + 90px)); opacity: 0; }
	}
</style>

<script>
	const btn = document.getElementById('matrix-btn');
	const layer = document.getElementById('matrix-layer');
	const chars = '#~[]{}()£$-+=*!?;:<>@0123456789';
	let interval: ReturnType<typeof setInterval>;

	btn?.addEventListener('mouseenter', () => {
		interval = setInterval(() => {
			const span = document.createElement('span');
			span.className = 'matrix-char';
			span.textContent = chars[Math.floor(Math.random() * chars.length)];
			
			const zone = Math.random() < 0.5
				? Math.random() * 15
				: 80 + Math.random() * 15;
			span.style.left = zone + '%';

			layer?.appendChild(span);
			setTimeout(() => span.remove(), 1200);
		}, 120);
	});

	btn?.addEventListener('mouseleave', () => {
		clearInterval(interval);
		if (layer) layer.innerHTML = '';
	});
</script>

<script define:vars={{ lastfmApiKey: "PLACEHOLDER_KEY", lastfmUsername: "PLACEHOLDER_NAME"}}>
	async function updateNowPlaying() {
		const btn = document.getElementById('nowplaying-btn');
		const art = document.getElementById('nowplaying-art');
		const songEl = document.getElementById('nowplaying-song');
		const artistEl = document.getElementById('nowplaying-artist');
		const statusEl = document.getElementById('nowplaying-status');
		const arrowEl = document.getElementById('music-arrow');
		const belowImg = document.getElementById('vinyl-art');
		if (!btn || !songEl || !artistEl || !statusEl || !belowImg) return;

		try {
			const res = await fetch(
				`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${lastfmUsername}&api_key=${lastfmApiKey}&format=json&limit=1`
			);
			const data = await res.json();
			const track = data?.recenttracks?.track?.[0];

			if (track) {
				const artist = track.artist?.['#text'] ?? 'Unknown Artist';
				const name = track.name ?? 'Unknown Artist';
				const isNowPlaying = track['@attr']?.nowplaying === 'true';
				const albumArt = track.image?.find(img => img.size === 'large')?.['#text'];

				songEl.textContent = name;
				artistEl.textContent = artist;
				statusEl.textContent = isNowPlaying
					? `𝅘𝅥𝅮 Now playing - last.fm`
					: `Last played - last.fm`;

				if (albumArt && art) art.src = albumArt;
				if (track.url) btn.href = track.url;

				belowImg.src = isNowPlaying
					? `images/front-page/music-player.gif`
					: `images/front-page/music-idle.png`;

				btn.style.border = isNowPlaying
					? '1px solid #DC2626'
					: '1px solid black';

				songEl.style.color = isNowPlaying
					? '#B91C1C'
					: 'black';
				
				artistEl.style.color = isNowPlaying
					? '#EF4444'
					: 'black';
				
				statusEl.style.color = isNowPlaying
					? '#F87171'
					: 'black';

				arrowEl.style.color = isNowPlaying
					? '#F87171'
					: 'black';
				
			} else {
				songEl.textContent = 'No recent tracks';
				artistEl.textContent = '';
				statusEl.textContent = '';
			}
		} catch (err) {
			text.textContent = 'Unable to load';
			console.error('Last.fm fetch failed', err);
		}
	}

	updateNowPlaying();
	setInterval(updateNowPlaying, 60000);
</script>