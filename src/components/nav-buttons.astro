---
import '../styles/global.css';
import Externals from './externals.astro';

interface Props {
    color?: string; 
    font?: string;
}

const { color = "gray", font = "font-sans" } = Astro.props;

const BtnColors: Record<string, string> = {
    gray: 'text-gray-600  border border-gray-700',
    blue: 'text-blue-600  border border-blue-700',
    purple: 'text-purple-600  border border-purple-700',
    green: 'text-green-600  border border-green-700',
}
const defaultBtnColor = 'fill-gray-700'
---
<div class="flex flex-row w-full">
    <div class="flex gap-4 mt-4 ml-4">
        <a href="/" class={`px-4 py-2 ${font} ${BtnColors[color] ?? defaultBtnColor} rounded-lg hover:text-black hover:border-black hover:bg-gray-100 transition-colors`}>
            Office (Home)
        </a>
        <a href="/blog/" class={`px-4 py-2 ${font} ${BtnColors[color] ?? defaultBtnColor} rounded-lg hover:text-blue-400 hover:border-blue-400 hover:bg-blue-100 transition-colors`}>
            Blog
        </a>
        <a href="/about/" class={`px-4 py-2 ${font} ${BtnColors[color] ?? defaultBtnColor} rounded-lg hover:text-purple-400 hover:border-purple-400 hover:bg-violet-200 transition-colors`}>
            About Me
        </a>
        <a href="/projects/" class={`px-4 py-2 ${font} ${BtnColors[color] ?? defaultBtnColor} rounded-lg hover:text-green-400 hover:border-green-400 hover:bg-green-800 transition-colors`}>
            Projects
        </a>
    </div>
    <div class="ml-auto">
        <Externals color={`${color}`} />
    </div>
</div>