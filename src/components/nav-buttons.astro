---
import '../styles/global.css';

interface Props {
    color?: string; 
    font?: string;
}

const { color = "gray", font = "font-sans" } = Astro.props;
---

<div class="flex gap-4 mt-4 ml-4">
    <a href="/" class={`px-4 py-2 text-${color}-400 ${font} border border-${color}-400 rounded-lg hover:text-black hover:bg-gray-100 transition-colors`}>
        Office (Home)
    </a>
    <a href="/blog/" class={`px-4 py-2 text-${color}-400 ${font} border border-${color}-400 rounded-lg hover:text-blue-400 hover:bg-blue-100 transition-colors`}>
        Blog
    </a>
    <a href="/about/" class={`px-4 py-2 text-${color}-400 ${font} border border-${color}-400 rounded-lg hover:text-purple-400 hover:bg-violet-200 transition-colors`}>
        About Me
    </a>
    <a href="/projects" class={`px-4 py-2 text-${color}-400 ${font} border border-${color}-400 rounded-lg hover:text-green-400 hover:bg-green-800 transition-colors`}>
        Projects
    </a>
</div>